<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Lockstep.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Lockstep brand accent (indigo / violet), used by every WinUI control in place of
                 the Windows accent colour so the app looks the same on every PC. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#6366F1</Color>
                    <Color x:Key="SystemAccentColorLight1">#818CF8</Color>
                    <Color x:Key="SystemAccentColorLight2">#A5B4FC</Color>
                    <Color x:Key="SystemAccentColorLight3">#C7D2FE</Color>
                    <Color x:Key="SystemAccentColorDark1">#4F46E5</Color>
                    <Color x:Key="SystemAccentColorDark2">#4338CA</Color>
                    <Color x:Key="SystemAccentColorDark3">#3730A3</Color>
                    <SolidColorBrush x:Key="HeroTileOverlayBrush" Color="#33FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#5B5BD6</Color>
                    <Color x:Key="SystemAccentColorLight1">#7C7CF0</Color>
                    <Color x:Key="SystemAccentColorLight2">#A5A8F7</Color>
                    <Color x:Key="SystemAccentColorLight3">#C9CBFB</Color>
                    <Color x:Key="SystemAccentColorDark1">#4F46E5</Color>
                    <Color x:Key="SystemAccentColorDark2">#4338CA</Color>
                    <Color x:Key="SystemAccentColorDark3">#3730A3</Color>
                    <SolidColorBrush x:Key="HeroTileOverlayBrush" Color="#22FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Cyan to indigo, as in the logo and banner. -->
            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#22D3EE" Offset="0" />
                <GradientStop Color="#6366F1" Offset="0.6" />
                <GradientStop Color="#8B5CF6" Offset="1" />
            </LinearGradientBrush>

            <!-- Rounded "pill" used for risk levels, categories and app groups. -->
            <Style x:Key="PillBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Padding" Value="9,2,9,3" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PillTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Slightly rounder, airier cards everywhere. -->
            <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
