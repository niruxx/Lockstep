<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lockstep.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Lockstep.ViewModels"
    Title="Lockstep">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource BrandGradientBrush}">
                    <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="White" />
                </Border>
                <TextBlock Text="Lockstep" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Text="Privacy and control for every Windows PC" Opacity="0.55"
                           Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="270"
                        SelectionChanged="Nav_SelectionChanged">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search tweaks" QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Tools &amp; backup" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="32,12,32,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: gradient icon tile, title and description, plus how much is applied -->
                <Grid ColumnSpacing="18" Padding="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56" CornerRadius="16" VerticalAlignment="Top" Background="{StaticResource BrandGradientBrush}">
                        <Border CornerRadius="16" BorderThickness="1" BorderBrush="{ThemeResource HeroTileOverlayBrush}" />
                        <FontIcon x:Name="HeaderIcon" Glyph="&#xE71D;" FontSize="24" Foreground="White" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="HeaderSubtitle" Opacity="0.7" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel x:Name="HeaderMeter" Grid.Column="2" Spacing="6" VerticalAlignment="Center" MinWidth="170" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Right">
                            <Run x:Name="HeaderMeterValue" FontSize="22" FontWeight="SemiBold" />
                            <Run x:Name="HeaderMeterTotal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <ProgressBar x:Name="HeaderMeterBar" Maximum="1" Height="6" CornerRadius="3" />
                        <TextBlock Text="applied on this PC" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Notices -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <InfoBar x:Name="ElevationBar" Severity="Error" IsClosable="False"
                             Title="Not running as administrator"
                             Message="Most tweaks change machine-wide settings. Close Lockstep and start it with &quot;Run as administrator&quot;." />
                    <InfoBar x:Name="StatusBar" IsClosable="True" />

                </StackPanel>

                <!-- Toolbar -->
                <Grid x:Name="Toolbar" Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <DropDownButton Content="Select">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Text="Recommended only" Tag="recommended" Click="Select_Click" />
                                    <MenuFlyoutItem Text="Recommended + Limited" Tag="limited" Click="Select_Click" />
                                    <MenuFlyoutItem Text="Everything except Extreme" Tag="aggressive" Click="Select_Click" />
                                    <MenuFlyoutItem Text="Everything shown" Tag="all" Click="Select_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Not-yet-applied shown" Tag="notapplied" Click="Select_Click" />
                                    <MenuFlyoutItem Text="Applied shown" Tag="applied" Click="Select_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Clear selection" Tag="none" Click="Select_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Click="Preset_Click" Tag="recommended"
                                ToolTipService.ToolTip="Apply every non-risky (Recommended) tweak in every category that isn't applied yet">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                <TextBlock Text="Apply recommended" />
                            </StackPanel>
                        </Button>
                        <Button Click="Refresh_Click" ToolTipService.ToolTip="Re-check the current state of every tweak">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,8,0" />
                        <Button x:Name="RevertButton" Click="Revert_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                <TextBlock Text="Revert selected" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ApplyButton" Click="Apply_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                <TextBlock Text="Apply selected" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Tweak list -->
                <ListView x:Name="TweakList" Grid.Row="3" ItemsSource="{x:Bind VisibleTweaks}"
                          SelectionMode="None" Padding="0,0,12,0">
                    <ListView.Header>
                        <StackPanel>
                            <!-- Performance clean-up (Performance page only) -->
                            <Grid x:Name="PerfCard" Visibility="Collapsed" Margin="0,0,0,12" Padding="16" ColumnSpacing="16"
                                  CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Free up disk space" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                               Text="Deletes temp files older than a day and the Delivery Optimization cache, or removes superseded Windows Update files (DISM component clean-up, runs in its own window and can take a while)." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Clean temporary files" Tag="cleantemp" Click="Perf_Click" HorizontalAlignment="Stretch" />
                                    <Button Content="Clean up Windows Update files" Tag="componentcleanup" Click="Perf_Click" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>

                            <!-- DNS provider (Network page only) -->
                            <Grid x:Name="DnsCard" Visibility="Collapsed" Margin="0,0,0,12" Padding="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="DNS provider" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="DnsDescriptionText" TextWrapping="Wrap" Opacity="0.75" />
                                    <TextBlock x:Name="DnsCurrentText" TextWrapping="Wrap" Opacity="0.6" FontSize="12" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox x:Name="DnsProviderBox" MinWidth="220" SelectionChanged="DnsProviderBox_SelectionChanged" />
                                    <Button x:Name="DnsApplyButton" Content="Apply" Click="DnsApply_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Active hours (Windows Update page only) -->
                            <Grid x:Name="ActiveHoursCard" Visibility="Collapsed" Margin="0,0,0,12" Padding="16" ColumnSpacing="16" RowSpacing="8"
                                  CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Active hours" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="ActiveHoursText" TextWrapping="Wrap" Opacity="0.75" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ComboBox x:Name="ActiveStartBox" Header="From" MinWidth="100" SelectionChanged="ActiveHours_Changed" />
                                    <ComboBox x:Name="ActiveEndBox" Header="Until" MinWidth="100" SelectionChanged="ActiveHours_Changed" />
                                    <Button x:Name="ActiveHoursSaveButton" Content="Save" VerticalAlignment="Bottom" Click="ActiveHoursSave_Click"
                                            Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <!-- GDID status (Device identity page only) -->
                            <Grid x:Name="GdidCard" Visibility="Collapsed" Margin="0,0,0,12" Padding="16" ColumnSpacing="24" RowSpacing="12"
                                  CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Stored GDID" Opacity="0.7" />
                                    <TextBlock Text="Windows sign-in" Opacity="0.7" />
                                    <TextBlock Text="Microsoft accounts in apps" Opacity="0.7" />
                                    <TextBlock Text="Account service (wlidsvc)" Opacity="0.7" />
                                    <TextBlock Text="Connected Devices Platform" Opacity="0.7" />
                                    <TextBlock Text="Delivery Optimization" Opacity="0.7" />
                                    <TextBlock Text="Telemetry service" Opacity="0.7" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock x:Name="GdidValueText" FontFamily="Cascadia Mono, Consolas" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="GdidAccountText" />
                                    <TextBlock x:Name="GdidAppAccountsText" />
                                    <TextBlock x:Name="GdidWlidText" />
                                    <TextBlock x:Name="GdidCdpText" />
                                    <TextBlock x:Name="GdidDoText" />
                                    <TextBlock x:Name="GdidTelemetryText" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Refresh" Tag="gdid-refresh" Click="Gdid_Click" />
                                    <Button Content="Reset local device identity…" Tag="gdid-reset" Click="Gdid_Click" />
                                    <Button x:Name="GdidRestoreButton" Content="Restore previous identity" Tag="gdid-restore" Click="Gdid_Click" />
                                    <HyperlinkButton Content="Use a local account instead" NavigateUri="ms-settings:yourinfo" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TweakItem">
                            <Grid Padding="16,12" ColumnSpacing="12" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="130" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0"
                                          VerticalAlignment="Top" Margin="0,-4,0,0" />

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.75" />
                                    <TextBlock Text="{x:Bind Warning}" Visibility="{x:Bind WarningVisibility}"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <Expander Header="What this changes" Margin="0,4,0,0" Padding="12,8"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <TextBlock Text="{x:Bind Details}" FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Expander>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Ellipse Width="8" Height="8" Fill="{x:Bind StatusBrush, Mode=OneWay}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" Opacity="0.85" />
                                    </StackPanel>
                                    <Border Style="{StaticResource PillBorderStyle}" HorizontalAlignment="Right"
                                            Background="{x:Bind RiskTint}" BorderBrush="{x:Bind RiskBorder}">
                                        <TextBlock Text="{x:Bind RiskLabel}" Style="{StaticResource PillTextStyle}" Foreground="{x:Bind RiskText}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Apps -->
                <Grid x:Name="AppsPanel" Grid.Row="2" Grid.RowSpan="2" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>



                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="AppFilterBox" SelectedIndex="0" MinWidth="220"
                                      SelectionChanged="AppFilterBox_SelectionChanged">
                                <ComboBoxItem Content="All removable apps" Tag="removable" />
                                <ComboBoxItem Content="Suggested to remove" Tag="suggested" />
                                <ComboBoxItem Content="Microsoft apps" Tag="microsoft" />
                                <ComboBoxItem Content="Third-party apps" Tag="thirdparty" />
                                <ComboBoxItem Content="System components" Tag="system" />
                                <ComboBoxItem Content="Hidden apps (other accounts / new users)" Tag="hidden" />
                                <ComboBoxItem Content="Previously removed" Tag="removed" />
                                <ComboBoxItem Content="Optional Windows apps to install" Tag="available" />
                            </ComboBox>
                            <DropDownButton Content="Select">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Text="All suggested bloatware" Tag="suggested" Click="AppSelect_Click" />
                                        <MenuFlyoutItem Text="Everything shown" Tag="all" Click="AppSelect_Click" />
                                        <MenuFlyoutItem Text="Everything Lockstep removed" Tag="removed" Click="AppSelect_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Clear selection" Tag="none" Click="AppSelect_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button Click="AppsRefresh_Click" ToolTipService.ToolTip="Reload the list of installed apps">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="AppsBusy" IsActive="False" Width="20" Height="20" />
                            <TextBlock x:Name="AppsSelectionText" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,8,0" />
                            <Button x:Name="InstallButton" Click="Install_Click"
                                    ToolTipService.ToolTip="Install the selected optional apps, or reinstall removed and hidden ones for your account">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Install / reinstall" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="UninstallButton" Click="Uninstall_Click" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="Uninstall selected" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>



                    <ListView x:Name="AppList" Grid.Row="1" ItemsSource="{x:Bind VisibleApps}"
                              SelectionMode="None" Padding="0,0,12,0">
                        <ListView.Header>
                            <StackPanel Spacing="12" Margin="0,0,0,12">
                                <!-- Microsoft Edge (desktop app, not a Store package) -->
                                <Expander x:Name="EdgeExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Expanding="EdgeExpander_Expanding">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                                            <FontIcon Glyph="&#xE774;" FontSize="20" />
                                            <StackPanel>
                                                <TextBlock Text="Microsoft Edge" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock x:Name="EdgeStatusText" Text="Expand to check" Opacity="0.7" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Padding="4,0">
                                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                                   Text="Uses Edge's own system-level uninstaller, so nothing is deleted by hand. Edge isn't a Store app, which is why it isn't in the list below. Another browser must be installed first." />
                                        <CheckBox x:Name="EdgeKeepWebViewBox" IsChecked="True"
                                                  >
                                            <TextBlock TextWrapping="Wrap" Text="Keep the WebView2 Runtime and Edge Update (recommended: Teams, new Outlook, Widgets, Office add-ins and many other apps need WebView2)" />
                                        </CheckBox>
                                        <CheckBox x:Name="EdgeBlockReinstallBox" IsChecked="True"
                                                  >
                                            <TextBlock TextWrapping="Wrap" Text="Stop Edge Update reinstalling the Edge browser (WebView2 keeps updating)" />
                                        </CheckBox>
                                        <CheckBox x:Name="EdgeDeleteDataBox" IsChecked="False"
                                                  >
                                            <TextBlock TextWrapping="Wrap" Text="Also delete Edge browsing data (favorites, passwords, history). Export anything you need first." />
                                        </CheckBox>
                                        <CheckBox x:Name="EdgeRestorePointBox" IsChecked="True" Content="Create a system restore point first" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="EdgeUninstallButton" Content="Uninstall Edge…" Tag="uninstall" Click="Edge_Click"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            <Button x:Name="EdgeReinstallButton" Content="Reinstall Edge" Tag="reinstall" Click="Edge_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="OneDriveExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Expanding="OneDriveExpander_Expanding">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                                            <FontIcon Glyph="&#xE753;" FontSize="20" />
                                            <StackPanel>
                                                <TextBlock Text="Microsoft OneDrive" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock x:Name="OneDriveStatusText" Text="Expand to check" Opacity="0.7" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Padding="4,0">
                                        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                                   Text="Uninstalls the OneDrive desktop app with its own uninstaller. Your OneDrive folder and every file already downloaded stay where they are. Files marked online-only (cloud icon) are NOT on this PC: right-click your OneDrive folder and choose &quot;Always keep on this device&quot; first if you need them offline." />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="OneDriveUninstallButton" Content="Uninstall OneDrive…" Tag="uninstall" Click="OneDrive_Click"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                            <Button x:Name="OneDriveReinstallButton" Content="Reinstall OneDrive" Tag="reinstall" Click="OneDrive_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="AllUsersBox" IsChecked="True">
                                        <TextBlock TextWrapping="Wrap" Text="Remove for every user account on this PC" />
                                    </CheckBox>
                                    <CheckBox x:Name="DeprovisionBox" IsChecked="True">
                                        <TextBlock TextWrapping="Wrap" Text="Stop Windows reinstalling it for new users and after updates" />
                                    </CheckBox>
                                    <HyperlinkButton x:Name="UndoAppsLink" Content="Undo: reinstall everything Lockstep removed…" Click="UndoApps_Click" Padding="0,4" />
                                </StackPanel>
                            </StackPanel>
                        </ListView.Header>                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppItem">
                                <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind IsSelectable}"
                                              MinWidth="0" VerticalAlignment="Center" />
                                    <Image Grid.Column="1" Source="{x:Bind Logo}" Width="32" Height="32" />
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Note}" Visibility="{x:Bind NoteVisibility}" FontSize="12"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StateText}" Visibility="{x:Bind StateVisibility}"
                                                   FontSize="12" Opacity="0.7" VerticalAlignment="Center" MaxWidth="260" TextWrapping="Wrap" TextAlignment="Right" />
                                        <FontIcon Glyph="&#xE72E;" FontSize="12" Visibility="{x:Bind LockVisibility}"
                                                  ToolTipService.ToolTip="Required by Windows; can't be removed here" />
                                        <Border Style="{StaticResource PillBorderStyle}" Background="{x:Bind GroupTint}" BorderBrush="{x:Bind GroupBorder}">
                                            <TextBlock Text="{x:Bind GroupLabel}" Style="{StaticResource PillTextStyle}" Foreground="{x:Bind GroupText}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Install -->
                <Grid x:Name="InstallPanel" Grid.Row="2" Grid.RowSpan="2" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="InstallCategoryBox" MinWidth="200" SelectionChanged="InstallFilter_Changed" />
                            <ComboBox x:Name="InstallManagerBox" MinWidth="170" SelectedIndex="0"
                                      ToolTipService.ToolTip="Which package manager installs the selected apps">
                                <ComboBoxItem Content="Install with winget" Tag="winget" />
                                <ComboBoxItem Content="Install with Chocolatey" Tag="choco" />
                            </ComboBox>
                            <Button Click="InstallRefresh_Click" ToolTipService.ToolTip="Re-check package managers and installed apps">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="InstallBusy" IsActive="False" Width="20" Height="20" />
                            <TextBlock x:Name="InstallSelectionText" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,8,0" />
                            <Button x:Name="InstallAppsButton" Click="InstallApps_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="Install selected" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="InstallList" Grid.Row="1" ItemsSource="{x:Bind VisibleCatalog}" SelectionMode="None" Padding="0,0,12,0">
                        <ListView.Header>
                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                <TextBlock x:Name="InstallManagersText" TextWrapping="Wrap" Opacity="0.8" />
                                <HyperlinkButton Content="Install or manage package managers and their repositories" Click="GoToRepositories_Click" Padding="0,2" />
                            </StackPanel>
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CatalogItem">
                                <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Opacity="0.75" />
                                        <TextBlock Text="{x:Bind Ids}" FontSize="11" Opacity="0.5" FontFamily="Cascadia Mono, Consolas" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource PillBorderStyle}" HorizontalAlignment="Right"
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}" BorderBrush="{ThemeResource AccentFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind Category}" Style="{StaticResource PillTextStyle}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" HorizontalAlignment="Right"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <!-- Third-party repositories -->
                <ScrollViewer x:Name="RepositoriesPanel" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed">
                    <StackPanel Spacing="12" Padding="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="RepoRefresh_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <ProgressRing x:Name="RepoBusy" IsActive="False" Width="20" Height="20" />
                        </StackPanel>
                        <StackPanel x:Name="RepoList" Spacing="16" />
                    </StackPanel>
                </ScrollViewer>

                <!-- App permissions -->
                <Grid x:Name="PermissionsPanel" Grid.Row="2" Grid.RowSpan="2" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PermCapabilityBox" MinWidth="220" SelectionChanged="PermCapabilityBox_SelectionChanged" />
                        <TextBlock x:Name="PermStatusText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8" />
                        <Button Grid.Column="2" Click="PermRefresh_Click" ToolTipService.ToolTip="Reload permissions">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListView x:Name="PermList" Grid.Row="1" ItemsSource="{x:Bind VisiblePermissions}" SelectionMode="None" Padding="0,0,12,0">
                        <ListView.Header>
                            <StackPanel Spacing="8" Margin="0,0,0,12">
                                <Grid Padding="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="PermUserSwitchTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                                   Text="Your master switch for this permission (all apps). Same as the top switch on the matching Settings page." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PermUserSwitch" Grid.Column="1" Toggled="PermUserSwitch_Toggled" OnContent="Allowed" OffContent="Blocked" />
                                </Grid>
                                <Grid Padding="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Desktop apps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                                   Text="Programs not from the Store share one switch. Windows can't block them one by one." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PermDesktopSwitch" Grid.Column="1" Toggled="PermDesktopSwitch_Toggled" OnContent="Allowed" OffContent="Blocked" />
                                </Grid>
                                <HyperlinkButton x:Name="ClearLocationLink" Content="Clear location history (opens Settings &gt; Location, press Clear)"
                                                 NavigateUri="ms-settings:privacy-location" Padding="0,2" Visibility="Collapsed" />
                                <TextBlock Text="Apps that asked for this permission" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                            </StackPanel>
                        </ListView.Header>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PermissionItem">
                                <Grid Padding="12,8" ColumnSpacing="12" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Allowed, Mode=TwoWay}" IsEnabled="{x:Bind IsEditable}"
                                                  OnContent="Allowed" OffContent="Denied" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Tools & backup -->
                <ScrollViewer x:Name="ToolsPanel" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed">
                    <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Presets" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Recommended" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Every non-risky tweak across all categories: telemetry, ads, Copilot and Recall, Edge tracking and more. Nothing you use stops working. Already-applied tweaks are skipped."
                                           TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Apply" Tag="recommended" Click="Preset_Click"
                                    Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Recommended + Limited" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Also turns off optional features such as location, OneDrive sync, Widgets, Spotlight, settings sync and app access to contacts and calendar. Aggressive and Extreme tweaks are never included in a preset."
                                           TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Apply" Tag="limited" Click="Preset_Click" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Profiles" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Export and import your configuration" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Export saves the tweaks you've ticked (or, if none are ticked, every tweak currently applied) plus any apps ticked on the Apps page to a .json file. Import ticks the tweaks from a file so you can review them and press Apply. Use the same file on other PCs or with --config."
                                           TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Export…" Tag="export" Click="Tool_Click" />
                                <Button Content="Import…" Tag="import" Click="Tool_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Keep settings applied" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="EnforceText" TextWrapping="Wrap" Opacity="0.75"
                                           Text="Windows updates sometimes switch settings back. When this is on, Lockstep checks every tweak you've applied each time you sign in and silently re-applies any that were reset. Results go to %ProgramData%\Lockstep\cli.log." />
                            </StackPanel>
                            <ToggleSwitch x:Name="EnforceToggle" Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="On" OffContent="Off" Toggled="EnforceToggle_Toggled" />
                        </Grid>
                        <Grid Padding="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1" RowSpacing="8"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Command line" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Apply presets or profiles without the window, e.g. in setup scripts. Run from an elevated terminal to see output in the terminal."
                                           TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                            <TextBlock x:Name="CliUsageText" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="Safety" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                        <HyperlinkButton Content="Show the welcome screen again" Tag="welcome" Click="Tool_Click" Padding="0,2" />
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Create a system restore point" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Turns System Restore on for the system drive if needed, then saves a snapshot you can roll back to from Windows Recovery."
                                           TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Create" Tag="restorepoint" Click="Tool_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Revert everything Lockstep changed" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="BackupSummary" TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Revert all" Tag="revertall" Click="Tool_Click" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Repair" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                        <Grid Padding="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Reset Windows Update" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Fixes stuck or failing updates: stops the update services, sets the download cache aside (kept as a .bak folder) and starts them again." />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset" Tag="resetwu" Click="Tool_Click" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock Text="Reset network" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Resets Winsock and the TCP/IP stack and flushes DNS. Fixes many &quot;connected, no internet&quot; problems. Static IP settings are cleared; needs a restart." />
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1" Content="Reset" Tag="resetnet" Click="Tool_Click" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="2" Spacing="2">
                                <TextBlock Text="Repair system files" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Runs DISM /RestoreHealth then SFC /scannow in their own window. Takes 10-30 minutes." />
                            </StackPanel>
                            <Button Grid.Row="2" Grid.Column="1" Content="Run" Tag="sfc" Click="Tool_Click" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="3" Spacing="2">
                                <TextBlock Text="Reinstall winget" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Opens App Installer in the Microsoft Store, which installs or repairs the winget package manager." />
                            </StackPanel>
                            <Button Grid.Row="3" Grid.Column="1" Content="Open" Tag="winget" Click="Tool_Click" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Windows features" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                        <Grid Padding="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="FeaturesText" TextWrapping="Wrap" Opacity="0.75"
                                       Text="Turn optional Windows components on or off. Press Check to read their current state (takes a few seconds)." />
                            <StackPanel x:Name="FeaturesList" Grid.Row="1" Spacing="2" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Check" Tag="features-check" Click="Tool_Click" />
                                <Button x:Name="FeaturesApplyButton" Content="Apply changes" Tag="features-apply" Click="Tool_Click"
                                        Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Classic panels" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                        <Grid Padding="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center"
                                       Text="Shortcuts to Control Panel, System Properties, Network Connections, Services, Device Manager, System Restore and other classic tools." />
                            <DropDownButton x:Name="PanelsButton" Grid.Column="1" Content="Open…" />
                        </Grid>

                        <TextBlock Text="Utilities" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Restart Explorer" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Applies taskbar, Start and File Explorer changes without signing out."
                                           TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Restart" Tag="explorer" Click="Tool_Click" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Hosts file" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Open the hosts file in Notepad, or flush the DNS cache so hosts changes take effect immediately."
                                           TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Open" Tag="hosts" Click="Tool_Click" />
                                <Button Content="Flush DNS" Tag="flushdns" Click="Tool_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid Padding="16" ColumnSpacing="16" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Backup folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="BackupPathText" TextWrapping="Wrap" Opacity="0.75" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open" Tag="backupfolder" Click="Tool_Click" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Log -->
                <Expander Grid.Row="4" Header="Activity log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Expander>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
